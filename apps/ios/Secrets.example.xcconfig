// Copy to Secrets.xcconfig (untracked) and fill in.
//
// DEVELOPMENT_TEAM is your Apple Developer Team ID. With a free Apple ID it is
// the personal team Xcode creates for you — find it in
// Xcode → Settings → Accounts → your Apple ID → the team's "Team ID" column,
// or run:  security find-identity -v -p codesigning
DEVELOPMENT_TEAM =

// Base URL of the signaling server. Leave empty to use the production default
// compiled into the app; point it at your Mac for local development, e.g.
// http://192.168.1.20:3000  (must be reachable from the iPhone, so not
// localhost — and the iPhone must be on the same Wi-Fi).
SIGNAL_BASE_URL =
